# Server-only. Inject the key through your secret manager.
HOOSPEC_AI_BASE_URL=https://ai.openhoo.ai/v1
HOOSPEC_AI_MODEL=anthropic/claude-sonnet-5.5
# Optional comma-separated allowlist for the editor model picker.
# If omitted, models returned by the authenticated provider catalog are available.
# HOOSPEC_AI_MODELS=anthropic/claude-sonnet-5.5,openai/gpt-5.1
HOOSPEC_AI_KEY=

# One persistent directory per single Node.js server.
# HOOSPEC_DATA_DIR=/data/hoospec
# Required if a reverse proxy changes the host or protocol.
# HOOSPEC_ORIGIN=https://spec.example.com

# Public GitLab Pages settings (these values are compiled into the static UI).
# Prefer hoospec.config.json; instance, project and branch are inherited from CI.
# HOOSPEC_PAGES_PATH=hoospec
# NEXT_PUBLIC_GITLAB_URL=https://gitlab.com
# NEXT_PUBLIC_GITLAB_PROJECT=group/project
# NEXT_PUBLIC_GITLAB_BRANCH=main
# NEXT_PUBLIC_GITLAB_CLIENT_ID=<public OAuth application ID; never a client secret>
# NEXT_PUBLIC_HOOSPEC_AGENT_URL=https://agent.example.com/api/repository-agent

# Optional, server-side bridge for statically hosted Pages deployments.
# Keep the actual token only in a protected server environment, never a NEXT_PUBLIC_ variable.
# HOOSPEC_PAGES_ORIGIN=https://group.gitlab.io
# HOOSPEC_REPOSITORY_AGENT_TOKEN=

# Optional per-user Copilot OAuth relay. Enable Device Flow on your own GitHub OAuth App.
# Public client ID; no client secret or shared Copilot access token required.
# HOOSPEC_COPILOT_CLIENT_ID=
# HOOSPEC_PAGES_ORIGIN=https://group.gitlab.io
# NEXT_PUBLIC_HOOSPEC_COPILOT_URL=https://agent.example.com/api/copilot

# Pages: public ID of your own GitHub OAuth App (Device Flow enabled).
# Uses the existing GitLab runner for login; no extra server.
# NEXT_PUBLIC_HOOSPEC_COPILOT_CLIENT_ID=
