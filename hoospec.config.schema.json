{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hoospec public deployment settings",
  "description": "Public settings only. Never place access tokens or client secrets in this file. Empty instance/project/branch values inherit GitLab CI defaults.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "gitlab": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "instance": { "type": "string", "maxLength": 1024 },
        "project": { "type": "string", "maxLength": 512 },
        "branch": { "type": "string", "maxLength": 255 },
        "clientId": { "type": "string", "maxLength": 1024 },
        "directory": { "type": "string", "default": "hoospec" },
        "specDirectory": { "type": "string", "default": "" },
        "adrDirectory": { "type": "string", "default": "docs/adr" }
      }
    },
    "agent": { "type": "object", "additionalProperties": false, "properties": { "url": { "type": "string", "maxLength": 1024 } } }
  },
  "required": ["schemaVersion"]
}
