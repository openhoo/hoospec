{
  "name": "hoospec",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3410",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx tests/integration.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:hoollm": "node scripts/hoollm.mjs dev",
    "start:hoollm": "node scripts/hoollm.mjs start",
    "build:pages": "node --import tsx scripts/build-pages.mjs",
    "test:gitlab": "node --import tsx tests/gitlab-live.mjs",
    "install:gitlab": "node scripts/install-gitlab.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:pages": "node scripts/test-pages.mjs",
    "test:container": "node scripts/test-container.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "A calm collaborative editor for Gherkin specifications and architecture decisions, with GitLab Pages integration.",
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0"
}
